{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "python3 scripts/hooks/guard.py",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "bash scripts/hooks/stop-gate.sh",
        "timeoutSec": 900
      }
    ]
  }
}
